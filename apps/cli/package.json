{
  "name": "@rivus/estela",
  "type": "module",
  "version": "0.2.0",
  "description": "Local viewer for agent sessions: every request, what the model saw, and what it cost.",
  "homepage": "https://github.com/PerfectPan/estela",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PerfectPan/estela.git",
    "directory": "apps/cli"
  },
  "bugs": {
    "url": "https://github.com/PerfectPan/estela/issues"
  },
  "license": "GPL-3.0-only",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "estela": "./dist/bin.mjs"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "node bin.mjs",
    "build": "vp pack",
    "lint": "vp lint src test scripts bin.mjs vite.config.ts 2>&1",
    "test": "vp test 2>&1",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@devframes/agentic": "1.3.3",
    "devframe": "catalog:"
  },
  "devDependencies": {
    "@bomb.sh/router": "0.8.0",
    "@clack/prompts": "1.8.1",
    "@perfectpan/lint-config": "catalog:",
    "@rivus/agent-kit": "catalog:",
    "@rivus/estela-kernel": "workspace:*",
    "@rivus/estela-rpc": "workspace:*",
    "@rivus/estela-runtime-node": "workspace:*",
    "@rivus/estela-schema": "workspace:*",
    "@rivus/estela-server": "workspace:*",
    "@rivus/estela-web": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:",
    "zod": "catalog:"
  }
}
