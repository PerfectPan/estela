{
  "name": "@rivus/agent-trace",
  "type": "module",
  "version": "0.1.0",
  "description": "DevFrame shell: CLI, static dump, and MCP over the agent-trace kernel.",
  "homepage": "https://github.com/PerfectPan/agent-trace",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PerfectPan/agent-trace.git",
    "directory": "apps/cli"
  },
  "bugs": {
    "url": "https://github.com/PerfectPan/agent-trace/issues"
  },
  "license": "GPL-3.0-only",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "agent-trace": "./dist/bin.mjs"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "node bin.mjs",
    "build": "vp pack",
    "lint": "vp lint src test scripts bin.mjs vite.config.ts 2>&1",
    "test": "vp test 2>&1",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@devframes/agentic": "1.1.0",
    "cac": "7.0.0",
    "devframe": "catalog:"
  },
  "devDependencies": {
    "@clack/prompts": "1.8.1",
    "@perfectpan/lint-config": "catalog:",
    "@rivus/agent-kit": "catalog:",
    "@rivus/agent-trace-kernel": "workspace:*",
    "@rivus/agent-trace-rpc": "workspace:*",
    "@rivus/agent-trace-runtime-node": "workspace:*",
    "@rivus/agent-trace-schema": "workspace:*",
    "@rivus/agent-trace-web": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:",
    "yaml": "catalog:",
    "zod": "catalog:"
  }
}
