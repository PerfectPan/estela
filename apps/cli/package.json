{
  "name": "@rivus/agent-trace",
  "type": "module",
  "version": "0.0.0",
  "description": "DevFrame shell: CLI, static dump, and MCP over the agent-trace kernel.",
  "homepage": "https://github.com/PerfectPan/agent-trace",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PerfectPan/agent-trace.git",
    "directory": "apps/cli"
  },
  "bugs": {
    "url": "https://github.com/PerfectPan/agent-trace/issues"
  },
  "license": "GPL-3.0-only",
  "engines": {
    "node": "^22.18.0 || >=23.6.0"
  },
  "bin": {
    "agent-trace": "./dist/bin.mjs"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "dev": "node bin.mjs",
    "build": "rslib build",
    "lint": "oxlint -c ../../.oxlintrc.json src scripts bin.mjs rslib.config.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@devframes/agentic": "1.0.0",
    "cac": "7.0.0",
    "devframe": "1.0.0"
  },
  "devDependencies": {
    "@clack/prompts": "1.8.1",
    "@perfectpan/lint-config": "github:PerfectPan/lint-config#v0.1.0",
    "@rivus/agent-trace-host-claude-code": "workspace:*",
    "@rivus/agent-trace-host-codex": "workspace:*",
    "@rivus/agent-trace-host-grok": "workspace:*",
    "@rivus/agent-trace-kernel": "workspace:*",
    "@rivus/agent-trace-rpc": "workspace:*",
    "@rivus/agent-trace-runtime-node": "workspace:*",
    "@rivus/agent-trace-schema": "workspace:*",
    "@rivus/agent-trace-web": "workspace:*",
    "@rslib/core": "1.0.2",
    "@types/node": "^24.5.2",
    "oxfmt": "0.70.0",
    "oxlint": "^1.86.0",
    "oxlint-tsgolint": "^7.0.2003",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
