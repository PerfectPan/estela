{
  "name": "@rivus/estela-e2e",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "license": "GPL-3.0-only",
  "description": "Smoke and browser end-to-end tests against the packed @rivus/estela tarball.",
  "scripts": {
    "build": "tsc --noEmit",
    "lint": "vp lint src vite.config.ts playwright.config.ts 2>&1",
    "typecheck": "tsc --noEmit",
    "test:smoke": "vp test 2>&1",
    "test:e2e": "playwright test --config playwright.config.ts"
  },
  "devDependencies": {
    "@perfectpan/lint-config": "catalog:",
    "@playwright/test": "1.65.0",
    "@types/node": "catalog:",
    "node-pty": "1.2.0-beta.18",
    "tinyexec": "1.3.1",
    "typescript": "catalog:",
    "vite-plus": "catalog:",
    "zod": "catalog:"
  }
}
