{
  "name": "@rivus/agent-trace-e2e",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "license": "GPL-3.0-only",
  "description": "Smoke and browser end-to-end tests against the packed @rivus/agent-trace tarball.",
  "devDependencies": {
    "@perfectpan/lint-config": "github:PerfectPan/lint-config#v0.6.0",
    "@playwright/test": "1.63.0",
    "@types/node": "^24.19.0",
    "node-pty": "1.2.0-beta.15",
    "typescript": "^7.0.2",
    "vite-plus": "1.1.0"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "lint": "vp lint src vite.config.ts playwright.config.ts 2>&1",
    "typecheck": "tsc --noEmit",
    "test:smoke": "vp test 2>&1",
    "test:e2e": "playwright test --config playwright.config.ts"
  }
}