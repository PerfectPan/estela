name: CI

on:
  pull_request:
    types: [ready_for_review]
  workflow_dispatch:

permissions:
  contents: read

concurrency:
  group: ci-${{ github.head_ref || github.ref_name }}
  cancel-in-progress: true

jobs:
  test:
    name: ${{ github.event_name == 'pull_request' && 'test' || 'manual checks' }}
    runs-on: ubuntu-latest
    timeout-minutes: 15
    steps:
      - uses: actions/checkout@v4
        with:
          fetch-depth: 0
      - uses: actions/setup-node@v4
        with:
          node-version: '22.18'
      - name: Repository checks
        run: |
          ./scripts/check-repository.sh
          node scripts/check-doc-translations.mjs
          node scripts/check-conventions.mjs
          node scripts/check-layers.mjs
      - name: Conventional PR title
        if: github.event_name == 'pull_request'
        env:
          PR_TITLE: ${{ github.event.pull_request.title }}
        run: ./scripts/check-pr-title.sh "$PR_TITLE"
      - name: Cache dependency downloads
        uses: actions/cache@v6
        with:
          path: |
            common/temp/pnpm-store
            ~/.npm/_cacache
          key: ${{ runner.os }}-dependency-downloads-${{ hashFiles('rush.json', 'common/config/rush/pnpm-lock.yaml', 'common/config/rush/pnpm-config.json') }}
          restore-keys: ${{ runner.os }}-dependency-downloads-
      - run: node common/scripts/install-run-rush.js install
      - name: Release intent
        if: github.event_name == 'pull_request'
        env:
          PR_BASE_REF: ${{ github.base_ref }}
        run: |
          base="$(git merge-base "origin/$PR_BASE_REF" HEAD)"
          node common/scripts/install-run-rush.js change --verify --no-fetch --target-branch "$base"
          node scripts/release-intent.mjs check --base "$base"
      - run: node common/scripts/install-run-rush.js lint
      - run: node scripts/check-browser-bundle.mjs
      - name: Build Web once before CLI smoke tests
        run: node common/scripts/install-run-rush.js build --only @rivus/agent-trace-web
      - run: node common/scripts/install-run-rush.js test
      - run: node common/scripts/install-run-rush.js typecheck
