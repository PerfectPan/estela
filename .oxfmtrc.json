{
  "$schema": "./apps/cli/node_modules/oxfmt/configuration_schema.json",
  "printWidth": 120,
  "tabWidth": 2,
  "useTabs": false,
  "semi": false,
  "singleQuote": true,
  "jsxSingleQuote": false,
  "quoteProps": "as-needed",
  "trailingComma": "all",
  "arrowParens": "avoid",
  "bracketSpacing": true,
  "experimentalOperatorPosition": "start",
  "embeddedLanguageFormatting": "off",
  "ignorePatterns": ["common/**", "**/fixtures/**", "docs/**", "**/*.md", "**/*.json", "**/*.html", "**/*.css"]
}
