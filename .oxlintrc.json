{
  // JSON `extends` paths resolve relative to this file, and Rush installs no
  // root node_modules. Every Rush project declares @perfectpan/lint-config at
  // the same version; packages/schema is used because every project depends on
  // it, so any install includes its node_modules.
  "extends": ["./packages/schema/node_modules/@perfectpan/lint-config/oxlint.json"],
  "ignorePatterns": ["**/dist/**", "**/node_modules/**", "common/temp/**", "common/deploy/**"],
  "categories": {
    "suspicious": "warn"
  },
  "rules": {
    // Casts sit at parse boundaries (JSONL records, SQLite rows, DevFrame payloads);
    // replacing them needs runtime validation, which is a separate change.
    "typescript/no-unsafe-type-assertion": "off",
    // Declared return types already cover this, and the rule does not follow
    // `never` calls such as `process.exit` or exhaustive switches.
    "typescript/consistent-return": "off",
    // Vitest's `expect(value, message)` takes a failure message.
    "vitest/valid-expect": ["error", { "maxArgs": 2 }],
    // Fire-and-forget `.then` at the end of a chain has nothing to return.
    "promise/always-return": ["warn", { "ignoreLastCallback": true }],
    "import/no-unassigned-import": ["warn", { "allow": ["**/*.css"] }],
    // agent-kit's Result errors carry their discriminator as `_tag`.
    "eslint/no-underscore-dangle": ["warn", { "allow": ["_tag"] }]
  },
  "overrides": [
    {
      "files": [
        "packages/schema/src/**/*.{ts,mts,cts,tsx}",
        "packages/kernel/src/**/*.{ts,mts,cts,tsx}",
        "packages/rpc/src/**/*.{ts,mts,cts,tsx}"
      ],
      "rules": {
        "no-restricted-imports": ["error", {
          "paths": [
            "fs", "fs/promises",
            "path", "path/promises",
            "os", "os/promises",
            "url", "url/promises",
            "process", "process/promises",
            "child_process", "child_process/promises",
            "crypto", "crypto/promises",
            "util", "util/promises",
            "stream", "stream/promises",
            "buffer", "buffer/promises"
          ],
          "patterns": ["node:*", "node:*/**"]
        }],
        "no-restricted-globals": ["error", "process", "Buffer"]
      }
    },
    {
      // One Icon base and the stroke icons built on it: a component family, which lint-config's
      // README exempts from one component per file (like a shadcn/ui file).
      "files": ["apps/web/src/components/icons.tsx"],
      "plugins": ["react"],
      "rules": { "react/no-multi-comp": "off" }
    },
    {
      "files": ["**/*.test.{ts,mts,cts,tsx}"],
      "rules": {
        "no-restricted-imports": "off",
        "no-restricted-globals": "off"
      }
    }
  ]
}
