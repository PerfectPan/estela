{
  "name": "@rivus/estela-schema",
  "type": "module",
  "version": "0.0.0",
  "license": "GPL-3.0-only",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "duplicates": "cd ../.. && jscpd --config packages/schema/node_modules/@perfectpan/lint-config/jscpd.json packages apps --ignore '**/node_modules/**,**/dist/**,**/coverage/**,**/.vite/**,**/*.json,**/*.test.ts' --format 'typescript,tsx'",
    "duplicates:audit": "cd ../.. && jscpd --config packages/schema/node_modules/@perfectpan/lint-config/jscpd-audit.json packages apps --absolute --output tmp/duplicates-audit --ignore '**/node_modules/**,**/dist/**,**/coverage/**,**/.vite/**,**/*.json' --format 'typescript,tsx'",
    "knip": "cd ../.. && knip",
    "lint": "vp lint src vite.config.ts 2>&1",
    "test": "vp test 2>&1",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@perfectpan/lint-config": "catalog:",
    "@rivus/agent-kit": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:",
    "jscpd": "5.4.3",
    "knip": "6.45.1"
  },
  "private": true
}
